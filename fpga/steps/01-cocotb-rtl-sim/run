#!/usr/bin/env bash
#=========================================================================
# 01-cocotb-rtl-sim
#=========================================================================
# Runs the subset of cocotb tests listed under `tests:` in the design yml
# on the RTL. The testbench lives in the sim/ suite and is shared with the
# gate-level simulation steps -- see scripts/cocotb-sim.mk.

# Stop on error and echo all commands

set -e
trap 'echo "CMD: $BASH_COMMAND"' DEBUG

# Colors

RED="\e[31m"
GREEN="\e[32m"
RESET="\e[0m"

# Determine RUNDIR

RUNDIR="$(dirname $(readlink -f "${BASH_SOURCE[0]}"))"
cd $RUNDIR

# Create fresh run.log and clear results from any previous run

rm -rf run.log results.xml sim_build waves.vcd
touch run.log

SRC_DIR=$(readlink -f {{src_dir}})
VERILOG_TOP=$(readlink -f {{verilog_top}})
TB_DIR=$(readlink -f {{tb_dir}})
SCRIPTS_DIR=$(readlink -f {{scripts_dir}})

TESTS="{{ (tests or []) | join(' ') }}"

if [[ -z "${TESTS}" ]]; then
  echo -e "${RED}ERROR${RESET}: no tests listed under 'tests:' in the design yml"
  exit 1
fi

if ! command -v vcs > /dev/null; then
  echo -e "${RED}ERROR${RESET}: vcs not found -- run 'module load synopsys-vcs'"
  echo "       (or source /classes/qca/setup-qca.sh) before running the flow"
  exit 1
fi

case "{{dump_vcd}}" in
  [Tt]rue) GEN_WAVES=True  ;;
  *)       GEN_WAVES=False ;;
esac

#-------------------------------------------------------------------------
# Simulate
#-------------------------------------------------------------------------

set +e
trap - DEBUG

make -f ${SCRIPTS_DIR}/cocotb-sim.mk \
  VERILOG_SOURCES="${VERILOG_TOP}" \
  INCLUDE_DIRS="$(dirname ${VERILOG_TOP}) ${SRC_DIR}" \
  TOP={{design_name}} \
  TB_DIR=${TB_DIR} \
  TB_MODULE={{tb_module}} \
  TESTS="${TESTS}" \
  GEN_WAVES=${GEN_WAVES} \
  2>&1 | tee -a run.log

set -e

#-------------------------------------------------------------------------
# Check results
#-------------------------------------------------------------------------

${SCRIPTS_DIR}/check-cocotb-results results.xml ${TESTS} | tee -a run.log
exit ${PIPESTATUS[0]}
