#!/usr/bin/env bash
#=========================================================================
# 06-bagl
#=========================================================================
# Back-annotated gate-level simulation: runs the subset of cocotb tests
# listed under `tests:` in the design yml on the post-synthesis netlist
# from 02-synth (no timing). The testbench and harness are the same ones
# used for RTL simulation -- see scripts/cocotb-sim.mk.

# Stop on error and echo all commands

set -e
trap 'echo "CMD: $BASH_COMMAND"' DEBUG

# Colors

RED="\e[31m"
GREEN="\e[32m"
RESET="\e[0m"

# Determine RUNDIR

RUNDIR="$(dirname $(readlink -f "${BASH_SOURCE[0]}"))"
cd $RUNDIR