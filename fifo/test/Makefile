# Parameters: -------------------------------------------------------
# HDL Language (always Verilog)
TOPLEVEL_LANG := verilog

# RTL Simulator (always Synopsys VCS)
SIM := vcs

# Top-level verilog source to test. Set appropiately depending on test mode.
VERILOG_SOURCES += $(PWD)/../src/sync_fifo.sv

# Sets top level module and corresponding python test module
TOPLEVEL = sync_fifo
MODULE = "fifo-test"

# Set to True if one wants to generate waves and coverage 
# report respectively. False otherwise
GEN_WAVES := True
GEN_COVERAGE_RPT := True

# Script ------------------------------------------------------------
# Add working directory to the Python virtual environment path
PWD=$(shell pwd)
export PYTHONPATH := $(PWD):$(PYTHONPATH)

# Set GIT_PATH environment var to the top-level directory of the github repo
GIT_PATH=$(shell git rev-parse --show-toplevel)

# Add all include directories referenced in the verilog source file
COMPILE_ARGS += +incdir+$(GIT_PATH)/fifo/src

# Enable systemverilog 
COMPILE_ARGS += -sverilog

# "tells VCS to do something sane with xpropagation" -Prof.Batten; ensure this is kept enabled
COMPILE_ARGS += -xprop=tmerge

GEN_WAVES ?= False
ifeq ($(GEN_WAVES), True)
	EXTRA_ARGS += +vcs+dumpvars+waves.vcd
	EXTRA_ARGS += +vcs+vcdpluson
	EXTRA_ARGS += +vcs+vcdplusmemon
endif

GEN_COVERAGE_RPT ?= False
ifeq ($(GEN_COVERAGE_RPT), True)
	COMPILE_ARGS += -cm line+tgl
	SIM_ARGS += -cm line+tgl
endif

# ***DO NOT REMOVE***
include $(shell cocotb-config --makefiles)/Makefile.sim

# Make Housekeeping Tasks -------------------------------------------
# Description: Removing all files generated by a simulation
clean_all:
	@echo "Cleaning all files generated by simulation"
	rm -f waves.vcd
	rm -f vcdplus.vpd
	rm -rf coverage_report
	rm -rf results.xml
	make clean

#Description: Generate a coverage report after running a simulation
coverage_report:
	urg -dir ./sim_build/simv.vdb -format both -report ./coverage_report


# Make Test Tasks ---------------------------------------------------
#*** Tasks to test different module parameters ***
# NOTE, you need to clean for parameters to take effect
# The convention for naming test tasks should be:
#              "test_<PARAM1_VAL>_<PARAM2_VAL>_..."

# Runs all test_* tasks and tests with default module params
.PHONY: test_all clean
test_all:
	@PASS=0; FAIL=0; \
	for t in $(shell grep -E '^test_[^:]+:' Makefile | cut -d':' -f1 | grep -v test_all); do \
		echo "================ RUNNING $$t ================"; \
		LOG=$$(mktemp); \
		if $(MAKE) $$t > $$LOG 2>&1; then \
			P=$$(grep -oE 'PASS=[0-9]+' $$LOG | cut -d= -f2); \
			F=$$(grep -oE 'FAIL=[0-9]+' $$LOG | cut -d= -f2); \
			PASS=$$((PASS + P)); \
			FAIL=$$((FAIL + F)); \
			cat $$LOG; \
		else \
			echo "$$t FAILED TO RUN"; \
			FAIL=$$((FAIL + 1)); \
		fi; \
		$(MAKE) clean; \
		rm -f $$LOG; \
	done; \
	echo "================ SUMMARY ================"; \
	echo "TOTAL PASSED: $$PASS"; \
	echo "TOTAL FAILED: $$FAIL"; \
	echo "========================================="

# Runs tests with dut.Width = DEFAULT
test_default:
	$(MAKE)
